    },
    "Das wird schon Routine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is becoming routine."
          }
        }
      }
    },
    "Datenschutzerklärung": {
      "localizations": {
        "en": {
