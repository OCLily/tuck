    },
    "Nur auf diesem Gerät. Für die Fehlersuche.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this device only. For troubleshooting."
          }
        }
      }
    },
    "Diagnose Morgen: %lld Fenster eingetragen, %lld Intervalle gestartet, %lld Shields geschrieben, %lld ohne Rückmeldung, %lld Tage übersprungen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Diagnose Morgen: %1$lld Fenster eingetragen, %2$lld Intervalle gestartet, %3$lld Shields geschrieben, %4$lld ohne Rückmeldung, %5$lld Tage übersprungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning diagnostics: %1$lld windows saved, %2$lld intervals started, %3$lld shields written, %4$lld without a callback, %5$lld days skipped"
          }
        }
      }
    },
    "Diagnose Abend: %lld Fenster eingetragen, %lld Intervalle gestartet, %lld Shields geschrieben, %lld ohne Rückmeldung": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Diagnose Abend: %1$lld Fenster eingetragen, %2$lld Intervalle gestartet, %3$lld Shields geschrieben, %4$lld ohne Rückmeldung"
          }
        },
