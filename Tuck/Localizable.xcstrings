            "value": "No answer yet"
          }
        }
      }
    },
    "Zeigt die Optik einer Stufe an, ohne den gespeicherten Fortschritt zu ändern. „Echt“ zeigt wieder die Stufe der oben gezählten Morgen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the look of a stage without changing the stored progress. “Real” shows the stage of the mornings counted above again."
          }
        }
      }
    },
