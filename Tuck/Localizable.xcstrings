    "30 Minuten vor und 30 nach deiner Bettzeit bleiben dieselben Apps ruhig wie morgens. Mit Plus stellst du die Zeit hier ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 30 minutes before and 30 after your bedtime the same apps stay quiet as in the morning. With Plus you set the time here."
          }
        }
      }
    },
    "Abo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription"
          }
        }
      }
    },
    "Abo verwalten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage subscription"
          }
        }
      }
    },
    "An den anderen Tagen bleibt auch das Sperrfenster aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other days the block window stays off too."
          }
        }
      }
    },
    "Alles noch da.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is still here."
          }
        }
      }
    },
    "Alles, was wichtig ist, wartet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything that matters waits."
          }
        }
      }
    },
    "Als Grund gewählt: Anderes. Beide Wege stehen weiter offen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason chosen: Something else. Both ways stay open."
          }
        }
      }
    },
    "Als Grund gewählt: Arbeit. Beide Wege stehen weiter offen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason chosen: Work. Both ways stay open."
          }
        }
      }
    },
    "Als Grund gewählt: Notfall. Beide Wege stehen weiter offen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason chosen: Emergency. Both ways stay open."
          }
        }
      }
    },
    "Apple zählt auch Messenger wie WhatsApp und Nachrichten zu „Soziale Netze“. Wenn du morgens erreichbar bleiben willst, wähl lieber einzelne Apps aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple also counts messengers like WhatsApp and Messages as “Social”. If you want to stay reachable in the morning, pick individual apps instead."
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Apps, die warten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that wait"
          }
        }
      }
    },
    "Auch möglich, wenn du magst: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also possible, if you like: %@."
          }
        }
      }
    },
    "Ausatmen …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe out …"
          }
        }
      }
    },
    "Beim ersten Mal fragt iOS einmal nach Erlaubnis für Wecker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time, iOS asks once for alarm permission."
          }
        }
      }
    },
    "Bereit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        }
      }
    },
    "Bettzeit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedtime"
          }
        }
      }
    },
    "Bettzeit entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove bedtime"
          }
        }
      }
    },
    "Bettzeit entfernt. Für den Abend ist nichts mehr eingetragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedtime removed. Nothing is saved for the evening any more."
          }
        }
      }
    },
    "Bettzeit setzen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set bedtime"
          }
        }
      }
    },
    "Bettzeit wird gesetzt …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting bedtime …"
          }
        }
      }
    },
    "Bildschirmzeit-Zugriff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time access"
          }
        }
      }
    },
    "Bildschirmzeit-Zugriff prüfen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Screen Time access"
          }
