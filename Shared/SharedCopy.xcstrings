    },
    "Die Sperre bleibt bestehen. Morgen ist wieder ein neuer Morgen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The block stays. Tomorrow is a new morning."
          }
        }
