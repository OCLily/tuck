      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The block stays. Tomorrow is a new day."
          }
        }
      }
    },
    "Diese Zeit gehört dem Schlaf, nicht dem Feed. Der Griff zum Handy ist normal, gerade abends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time belongs to sleep, not to the feed. Reaching for the phone is normal, especially in the evening."
          }
        }
      }
    },
    "Diese Zeit gehört dir, nicht dem Feed. Der Griff zum Handy ist normal, gerade morgens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time belongs to you, not to the feed. Reaching for the phone is normal, especially in the morning."
          }
        }
      }
    },
    "Für heute aufgebraucht": {
